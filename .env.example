# Production token — used in Vercel Production environment
VITE_MIXPANEL_TOKEN=your_prod_token_here

# Dev/preview token — used locally and in Vercel Preview environment
# Create a second Mixpanel project (e.g. "Wardrobe Manager — Dev") and paste its token here
# VITE_MIXPANEL_TOKEN=your_dev_token_here

# Anthropic API key for the /api/recommend serverless function only.
#
# This deliberately has NO VITE_ prefix. Vite only inlines VITE_-prefixed
# variables into the client bundle, so an unprefixed name is structurally
# incapable of ever reaching the browser — do not rename it to add one.
ANTHROPIC_API_KEY=
